{
  "name": "wanderstory",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "postinstall": "prisma generate",
    "dev": "next dev --turbopack",
    "build": "next build --turbopack",
    "start": "next start",
    "lint": "eslint",
    "test:mf2": "node --experimental-test-module-mocks --import tsx --test tests/*.test.ts",
    "test:mf3": "node --experimental-test-module-mocks --import tsx --test tests/social-sharing.test.ts tests/journey-sharing-boundary.test.ts tests/journey-media-trust.test.ts tests/journey-public-media-boundary.test.ts tests/saved-journeys-storage.test.ts",
    "test:mf4a": "node --experimental-test-module-mocks --import tsx --test tests/social-draft-validation.test.ts tests/social-draft-eligibility.test.ts tests/social-draft-permissions.test.ts tests/social-draft-service.test.ts tests/social-draft-boundary.test.ts",
    "security:maintain": "tsx scripts/security-maintenance.ts",
    "destinations:ingest": "tsx scripts/destinations/ingest.mts",
    "destinations:verify": "tsx scripts/destinations/verify.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.8.0",
    "@prisma/client": "^7.8.0",
    "argon2": "^0.44.0",
    "cloudinary": "^2.10.0",
    "dotenv": "^17.4.2",
    "framer-motion": "^12.42.2",
    "lucide-react": "^1.24.0",
    "next": "^16.2.11",
    "next-auth": "^5.0.0-beta.31",
    "pg": "^8.22.0",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pg": "^8.20.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "15.5.20",
    "prisma": "^7.8.0",
    "tailwindcss": "^4",
    "tsx": "^4.23.0",
    "typescript": "^5"
  },
  "allowScripts": {
    "@prisma/engines@7.8.0": true,
    "argon2@0.44.0": true,
    "esbuild@0.28.1": true,
    "prisma@7.8.0": true,
    "sharp@0.34.5": true,
    "unrs-resolver@1.12.2": true
  }
}
