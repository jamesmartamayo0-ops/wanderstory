# Database
DATABASE_URL="postgresql://user:password@localhost:5432/wanderstory?schema=public"

# Migration/release tools require BOTH URLs explicitly in the process environment.
# These tools do not load .env and never substitute DATABASE_URL for DIRECT_URL.
# Supply credentials through your secret manager; no credentials belong here.
DIRECT_URL=""
MIGRATION_TARGET_ENVIRONMENT=""
MIGRATION_EXPECTED_DATABASE=""
MIGRATION_EXPECTED_RUNTIME_HOST=""
MIGRATION_EXPECTED_RUNTIME_PORT=""
MIGRATION_EXPECTED_DIRECT_HOST=""
MIGRATION_EXPECTED_DIRECT_PORT=""
MIGRATION_EXPECTED_PROJECT_REF=""
# Remote targets additionally require a protected production project reference.
# Production must match it; preview must differ. Same-project preview is refused.
MIGRATION_PRODUCTION_PROJECT_REF=""
# Ordinary local builds skip the deployment gate. Set 1 for explicit verification.
# VERCEL=1 always requires the gate, regardless of this value.
MIGRATION_STATUS_GATE="0"

# Public site origin
# NEXT_PUBLIC_SITE_URL is the authoritative production origin when configured.
# Vercel can fall back to VERCEL_PROJECT_PRODUCTION_URL automatically.
# If neither is valid HTTPS on Vercel, deployment intentionally fails instead
# of emitting incorrect public URLs. Localhost is for local development only.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Authentication — generate with: npx auth secret
AUTH_SECRET="your-auth-secret-here"

# Admin seed (creates initial admin on first run)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="your-admin-password"
ADMIN_NAME="Admin"

# Login rate limiting (brute-force defense)
# Email-keyed limiting is the PRIMARY defense and is always active.
# LOGIN_RATE_LIMIT: failures permitted per fixed window before the next
# attempt is blocked (e.g. 10 = attempts 1-10 permitted, 11th blocked).
# LOGIN_RATE_WINDOW_SECONDS: length of the fixed rate-limit window.
LOGIN_RATE_LIMIT="10"
LOGIN_RATE_WINDOW_SECONDS="900"

# Trusted-proxy handling. Keep OFF ("0"/unset) unless this host is deployed
# behind a confirmed reverse proxy that overwrites the x-forwarded-for /
# x-real-ip headers itself. When OFF, forwarded headers are NEVER trusted.
# IP-keyed rate limiting is a SECONDARY defense and only activates when
# TRUST_PROXY=1; the email-keyed limit remains the primary defense either way.
TRUST_PROXY="0"

# Media Storage (Cloudinary)
CLOUDINARY_CLOUD_NAME="your-cloud-name"
CLOUDINARY_API_KEY="your-api-key"
CLOUDINARY_API_SECRET="your-api-secret"

# Cron protection — guards /api/cron/security-maintenance
CRON_SECRET="your-cron-secret-here"
